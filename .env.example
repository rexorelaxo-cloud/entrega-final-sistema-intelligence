# === LLM ===
# "openai": usa OpenAI (requiere OPENAI_API_KEY).
# "deterministic": modo de pruebas sin LLM; supervisor por reglas, agentes sin llamadas a OpenAI
#                  y embeddings locales por hashing (solo para pruebas, no para producción).
LLM_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60

# === Redis (checkpointer de LangGraph) ===
# Requiere Redis con RediSearch y RedisJSON (Redis 8 o Redis Stack).
REDIS_URL=redis://localhost:6379

# === Vector store (Chroma en modo servidor) ===
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=localization_qa
# Ruta de persistencia del servidor Chroma (la usa docker-compose y `chroma run`).
VECTOR_STORE_PATH=./data/chroma
KNOWLEDGE_DIR=./knowledge

# === RAG ===
RAG_TOP_K=12
RAG_MIN_SCORE=0.15
RAG_CHUNK_MAX_CHARS=1200

# === Ejecución ===
MAX_FILES_PER_REQUEST=10
MAX_FILE_SIZE_BYTES=1048576
GRAPH_MAX_STEPS=12
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# === Observabilidad (Arize Phoenix) ===
TRACING_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=localization-qa
